<%- include('_tabs') %>
<h1>Cài đặt hệ thống</h1>
<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
<% if (saved) { %><div class="alert alert-info">Đã lưu cài đặt.</div><% } %>
<form method="post" action="/admin/settings" class="form-card">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label>Ngưỡng quá tải (số việc chưa hoàn thành tối đa của một người)
    <input type="number" name="overload_threshold" min="1" step="1" value="<%= threshold %>" required>
  </label>
  <button type="submit" class="btn btn-primary">Lưu</button>
</form>
<p><a class="btn" href="/admin/backup">Tải bản sao lưu dữ liệu</a></p>
<%
const f = msForm || { party_probation_months: ms.party_probation_months, service_months: ms.service_months, reminder_days: ms.reminder_days, rank_intervals: ms.rank_intervals };
const val = function (v) { return v === null || v === undefined ? '' : v; };
%>
<h2>Thời hạn nhắc mốc</h2>
<% if (msError) { %><div class="alert alert-error"><%= msError %></div><% } %>
<form method="post" action="/admin/settings/milestones" class="form-card">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <p class="muted">Để trống nếu chưa xác định; hệ thống sẽ không nhắc mốc đó.</p>
  <label>Thời gian đảng viên dự bị (tháng) <input type="number" name="party_probation_months" min="1" step="1" value="<%= val(f.party_probation_months) %>"></label>
  <label>Thời hạn phục vụ tại ngũ (tháng) <input type="number" name="service_months" min="1" step="1" value="<%= val(f.service_months) %>"></label>
  <label>Số ngày báo trước <input type="number" name="reminder_days" min="1" step="1" value="<%= val(f.reminder_days) %>"></label>
  <h3>Niên hạn xét thăng quân hàm (tháng)</h3>
  <div class="table-wrap"><table class="table">
    <thead><tr><th>Cấp bậc</th><th>Niên hạn (tháng)</th></tr></thead>
    <tbody>
    <% msRanks.forEach(function (rk) { %>
      <tr><td><%= rk %></td><td><input type="number" name="rank_intervals[<%= rk %>]" min="1" step="1" value="<%= val((f.rank_intervals || {})[rk]) %>"></td></tr>
    <% }) %>
    </tbody>
  </table></div>
  <p class="btn-row"><button type="submit" class="btn btn-primary">Lưu thời hạn nhắc mốc</button></p>
</form>
<h2>Thông tin đơn vị</h2>
<% if (unitError) { %><div class="alert alert-error"><%= unitError %></div><% } %>
<form method="post" action="/admin/settings/unit-info" class="form-card">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <p class="muted">Các thông tin này tự điền vào văn bản Word (tiêu ngữ, đơn vị, người ký...). Để trống ô nào thì văn bản để trống chỗ đó.</p>
  <p class="muted">Văn bản in đúng chữ hoa/thường như đồng chí gõ: cấp trên, đơn vị, Đảng ủy, Chi bộ, chức vụ người ký thường viết <strong>IN HOA</strong> (ví dụ TIỂU ĐOÀN 1, CHÍNH TRỊ VIÊN); địa danh, cấp bậc, họ tên viết hoa chữ cái đầu (ví dụ Đồng Nai, Thượng úy).</p>
  <% Object.keys(unitKeys).forEach(function (k) { %>
    <label><%= unitKeys[k] %> <input type="text" name="<%= k %>" maxlength="120" value="<%= unit[k] %>" placeholder="vd: <%= (typeof unitExamples !== 'undefined' && unitExamples[k]) || '' %>"></label>
  <% }) %>
  <button type="submit" class="btn btn-primary">Lưu thông tin đơn vị</button>
</form>
<h2 id="tro-ly-ai">Trợ lý AI</h2>
<% if (aiError) { %><div class="alert alert-error" role="alert"><%= aiError %></div><% } %>
<form method="post" action="/admin/settings/ai" class="form-card wide" id="ai-settings">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <p class="muted">Trợ lý AI chạy hoàn toàn trong mạng nội bộ qua phần mềm Ollama, không gửi dữ liệu ra Internet và không đọc hồ sơ quân nhân. Máy 8GB RAM nên dùng mô hình <strong>qwen2.5:3b</strong>. Có thể trỏ tới một máy khác trong mạng nội bộ (nhập địa chỉ IP, ví dụ http://192.168.1.50:11434); địa chỉ ngoài mạng nội bộ sẽ bị từ chối.</p>
  <label class="check"><input type="checkbox" name="ai_enabled" value="1" <%= ai.ai_enabled === '1' ? 'checked' : '' %>> Bật Trợ lý AI</label>
  <label>Địa chỉ máy AI <input type="text" name="ai_url" maxlength="200" value="<%= ai.ai_url %>" required></label>
  <label>Mô hình <input type="text" name="ai_model" maxlength="100" value="<%= ai.ai_model %>" required></label>
  <label>Thời gian chờ không thấy phản hồi (giây, 10–600) <input type="number" name="ai_timeout_s" min="10" max="600" step="1" value="<%= ai.ai_timeout_s %>" required></label>
  <h3>Văn bản mẫu để AI học văn phong (tùy chọn, tối đa 4000 ký tự mỗi mẫu)</h3>
  <label>Mẫu kế hoạch <textarea name="sample_ke_hoach" rows="5" maxlength="4000"><%= ai.ai_samples.ke_hoach %></textarea></label>
  <label>Mẫu báo cáo <textarea name="sample_bao_cao" rows="5" maxlength="4000"><%= ai.ai_samples.bao_cao %></textarea></label>
  <label>Mẫu chung <textarea name="sample_chung" rows="5" maxlength="4000"><%= ai.ai_samples.chung %></textarea></label>
  <p class="btn-row">
    <button type="submit" class="btn btn-primary">Lưu cài đặt Trợ lý AI</button>
    <button type="button" class="btn" id="ai-check">Kiểm tra kết nối</button>
    <span class="muted" id="ai-check-out" role="status"></span>
  </p>
</form>
<script>
(function () {
  var btn = document.getElementById('ai-check');
  var out = document.getElementById('ai-check-out');
  if (!btn) return;
  var meta = document.querySelector('meta[name="csrf"]');
  btn.addEventListener('click', function () {
    btn.disabled = true;
    out.textContent = 'Đang kiểm tra (đồng chí lưu cài đặt trước nếu vừa sửa)...';
    fetch('/admin/settings/ai/check', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'X-CSRF-Token': meta ? meta.content : '' }, body: '{}' })
      .then(function (r) { return r.json(); })
      .then(function (j) {
        if (j.ok) out.textContent = 'Kết nối được. Mô hình trên máy AI: ' + (j.models.join(', ') || '(chưa có)') + (j.hasModel ? '' : ' — chưa có mô hình đã cài đặt ở trên.');
        else out.textContent = 'Lỗi: ' + (j.error || 'không rõ');
      })
      .catch(function () { out.textContent = 'Lỗi kết nối hoặc phiên hết hạn, đồng chí tải lại trang.'; })
      .then(function () { btn.disabled = false; });
  });
})();
</script>
