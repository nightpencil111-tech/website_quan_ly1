<h1>Chọn đúng người</h1>
<p class="muted">Có tên trùng nhau; đồng chí chọn đúng người cho từng cụm rồi tiếp tục để kiểm tra phiếu giao việc.</p>
<form method="get" action="/assistant/task/pick" class="form-card wide">
  <input type="hidden" name="title" value="<%= draft.title %>">
  <% if (draft.priority) { %><input type="hidden" name="priority" value="<%= draft.priority %>"><% } %>
  <% if (draft.category) { %><input type="hidden" name="category" value="<%= draft.category %>"><% } %>
  <% if (draft.due_date) { %><input type="hidden" name="due_date" value="<%= draft.due_date %>"><% } %>
  <% resolved.forEach(function (a) { %><input type="hidden" name="assignee_ids" value="<%= a.id %>"><% }) %>
  <% draft.unmatched.forEach(function (u) { %><input type="hidden" name="unmatched" value="<%= u %>"><% }) %>
  <% draft.ambiguous.forEach(function (amb, i) { %>
    <fieldset>
      <legend>“<%= amb.phrase %>” là ai?</legend>
      <% amb.candidates.forEach(function (c, j) { %>
        <label class="check"><input type="radio" name="pick_<%= i %>" value="<%= c.id %>" <%= j === 0 ? 'required' : '' %>> <%= c.full_name %><% if (c.unit_name) { %> – <%= c.unit_name %><% } %></label>
      <% }) %>
    </fieldset>
  <% }) %>
  <button type="submit" class="btn btn-primary">Tiếp tục</button>
  <a class="btn" href="/assistant?tab=giao-viec">Quay lại</a>
</form>
