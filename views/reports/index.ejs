<h1>Báo cáo & Hiệu suất</h1>
<%- include('_nav', { active: 'report' }) %>
<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
<form method="get" action="/reports" class="range-form inline-form">
  <label>Từ ngày <input type="date" name="from" value="<%= range.from %>" required></label>
  <label>đến ngày <input type="date" name="to" value="<%= range.to %>" required></label>
  <button type="submit" class="btn btn-primary">Xem báo cáo</button>
  <a class="btn" href="/reports?from=<%= week.from %>&to=<%= week.to %>">Tuần này</a>
  <a class="btn" href="/reports?from=<%= month.from %>&to=<%= month.to %>">Tháng này</a>
</form>
<p>
  <button type="button" class="btn btn-primary" id="copy-btn">Sao chép</button>
  <a class="btn" href="/export/report?from=<%= range.from %>&to=<%= range.to %>">Xuất Excel</a>
  <span class="muted" id="copy-msg" role="status"></span>
</p>
<textarea id="report-text" class="report-text" readonly rows="28"><%= report.text %></textarea>
<script src="/js/report-copy.js"></script>
