<h1>Sự kiện</h1>
<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
<% if (canEdit) { %>
<form method="post" action="/calendar/events/<%= target.id %>" class="form-card wide">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label>Tiêu đề <input type="text" name="title" value="<%= form.title || '' %>" required maxlength="200"></label>
  <label>Loại
    <select name="type">
      <% Object.keys(EVENT_TYPES).forEach(function (k) { %><option value="<%= k %>" <%= form.type === k ? 'selected' : '' %>><%= EVENT_TYPES[k] %></option><% }) %>
    </select></label>
  <label>Từ ngày <input type="date" name="start_date" value="<%= form.start_date || '' %>" required></label>
  <label>Đến ngày <input type="date" name="end_date" value="<%= form.end_date || '' %>"></label>
  <label>Ghi chú <textarea name="description" rows="3"><%= form.description || '' %></textarea></label>
  <button type="submit" class="btn btn-primary">Lưu</button>
  <a class="btn" href="/calendar?y=<%= target.start_date.slice(0, 4) %>&m=<%= Number(target.start_date.slice(5, 7)) %>">Quay lại lịch</a>
</form>
<form method="post" action="/calendar/events/<%= target.id %>/delete" class="inline" style="margin-top:12px;display:block" data-confirm="Đồng chí chắc chắn xóa sự kiện này?">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <button type="submit" class="btn btn-danger">Xóa sự kiện</button>
</form>
<% } else { %>
<div class="panel" style="max-width:720px">
  <h2><%= target.title %></h2>
  <dl class="info">
    <dt>Loại</dt><dd><%= EVENT_TYPES[target.type] || 'Khác' %></dd>
    <dt>Thời gian</dt><dd><%= fmtDate(target.start_date) %><% if (target.end_date && target.end_date !== target.start_date) { %> – <%= fmtDate(target.end_date) %><% } %></dd>
    <% if (target.description) { %><dt>Ghi chú</dt><dd class="desc"><%= target.description %></dd><% } %>
  </dl>
  <a class="btn" href="/calendar?y=<%= target.start_date.slice(0, 4) %>&m=<%= Number(target.start_date.slice(5, 7)) %>">Quay lại lịch</a>
</div>
<% } %>
