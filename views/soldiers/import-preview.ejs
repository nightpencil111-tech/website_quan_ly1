<h1>Xem trước nhập hồ sơ</h1>
<p class="muted">Tệp: <%= d.fileName %> · Hợp lệ: <%= d.valid.length %> · Lỗi: <%= d.errors.length %> · Trùng: <%= d.duplicates.length %></p>
<h2>Hồ sơ hợp lệ</h2>
<div class="table-wrap"><table class="table">
  <thead><tr><th>Dòng</th><th>Họ và tên</th><th>Ngày sinh</th><th>Cấp bậc</th><th>Chức vụ</th><th>Đơn vị</th></tr></thead>
  <tbody>
  <% if (!d.valid.length) { %><tr><td colspan="6" class="muted">Không có hồ sơ hợp lệ.</td></tr><% } %>
  <% d.valid.forEach(function (s) { %>
    <tr><td><%= s.row %></td><td><%= s.full_name %></td><td><%= fmtDate(s.birth_date) %></td><td><%= s.rank || '–' %></td><td><%= s.position || '–' %></td><td><%= s.unit_name || '–' %></td></tr>
  <% }) %>
  </tbody>
</table></div>
<% if (d.errors.length) { %>
<h2>Dòng có lỗi (sẽ không được nhập)</h2>
<div class="table-wrap"><table class="table">
  <thead><tr><th>Dòng</th><th>Lỗi</th></tr></thead>
  <tbody><% d.errors.forEach(function (e) { %><tr><td><%= e.row %></td><td><%= e.message %></td></tr><% }) %></tbody>
</table></div>
<% } %>
<% if (d.duplicates.length) { %>
<h2>Hồ sơ trùng (sẽ bị bỏ qua)</h2>
<div class="table-wrap"><table class="table">
  <thead><tr><th>Dòng</th><th>Họ và tên</th></tr></thead>
  <tbody><% d.duplicates.forEach(function (e) { %><tr><td><%= e.row %></td><td><%= e.full_name %></td></tr><% }) %></tbody>
</table></div>
<% } %>
<div class="actions">
  <% if (d.valid.length) { %>
  <form method="post" action="/soldiers/import/<%= draftId %>/confirm" style="display:inline">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <button type="submit" class="btn btn-primary">Xác nhận nhập <%= d.valid.length %> hồ sơ</button>
  </form>
  <% } %>
  <form method="post" action="/soldiers/import/<%= draftId %>/cancel" style="display:inline">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <button type="submit" class="btn">Hủy</button>
  </form>
</div>
