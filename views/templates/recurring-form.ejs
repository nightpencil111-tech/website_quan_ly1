<h1><%= target ? 'Sửa việc định kỳ' : 'Thêm việc định kỳ' %></h1>
<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
<% const selected = form.assignee_ids.map(Number); %>
<form method="post" action="<%= target ? '/templates/recurring/' + target.id : '/templates/recurring' %>" class="form-card wide">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label>Tiêu đề <input type="text" name="title" value="<%= form.title || '' %>" required maxlength="200"></label>
  <label>Nội dung <textarea name="description" rows="3"><%= form.description || '' %></textarea></label>
  <label>Lĩnh vực
    <select name="category">
      <% Object.keys(LABELS.category).forEach(function (k) { %><option value="<%= k %>" <%= form.category === k ? 'selected' : '' %>><%= LABELS.category[k] %></option><% }) %>
    </select></label>
  <label>Mức ưu tiên
    <select name="priority">
      <% Object.keys(LABELS.priority).forEach(function (k) { %><option value="<%= k %>" <%= form.priority === k ? 'selected' : '' %>><%= LABELS.priority[k] %></option><% }) %>
    </select></label>
  <label>Tần suất
    <select name="frequency">
      <% Object.keys(FREQ).forEach(function (k) { %><option value="<%= k %>" <%= form.frequency === k ? 'selected' : '' %>><%= FREQ[k] %></option><% }) %>
    </select></label>
  <label>Ngày lặp (hằng tuần: 1 = Thứ Hai … 7 = Chủ nhật; hằng tháng: 1–31, tháng ngắn lấy ngày cuối tháng)
    <input type="number" name="day_value" min="1" max="31" value="<%= form.day_value %>" required></label>
  <label>Sinh việc trước hạn (ngày) <input type="number" name="lead_days" min="0" max="60" value="<%= form.lead_days %>" required></label>
  <fieldset class="assignees">
    <legend>Người thực hiện</legend>
    <% people.forEach(function (p) { %>
      <label class="check"><input type="checkbox" name="assignee_ids" value="<%= p.id %>" <%= selected.includes(p.id) ? 'checked' : '' %>> <%= p.full_name %><% if (p.rank) { %> (<%= p.rank %>)<% } %></label>
    <% }) %>
  </fieldset>
  <label class="check"><input type="checkbox" name="active" value="1" <%= Number(form.active) ? 'checked' : '' %>> Đang hoạt động</label>
  <button type="submit" class="btn btn-primary">Lưu</button>
  <a class="btn" href="/templates?tab=recurring">Hủy</a>
</form>
