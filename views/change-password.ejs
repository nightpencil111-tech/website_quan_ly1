<div class="auth-card">
  <h1>Đổi mật khẩu</h1>
  <% if (user.must_change_password) { %><div class="alert alert-info">Đây là lần đăng nhập đầu tiên, đồng chí cần đổi mật khẩu trước khi sử dụng hệ thống.</div><% } %>
  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
  <form method="post" action="/change-password">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label>Mật khẩu hiện tại
      <input type="password" name="current" autocomplete="current-password" required>
    </label>
    <label>Mật khẩu mới (tối thiểu 8 ký tự)
      <input type="password" name="password" autocomplete="new-password" minlength="8" required>
    </label>
    <label>Nhập lại mật khẩu mới
      <input type="password" name="confirm" autocomplete="new-password" minlength="8" required>
    </label>
    <button type="submit" class="btn btn-primary btn-block">Lưu mật khẩu</button>
  </form>
</div>
