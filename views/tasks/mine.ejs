<h1>Việc của tôi</h1>
<%# Task 6 thay danh sách này bằng "Việc cần làm hôm nay" (priorityScore) %>
<% if (!tasks.length) { %><p class="muted">Đồng chí hiện không có công việc nào đang thực hiện.</p><% } %>
<ul class="task-cards">
<% tasks.forEach(function (t) { %>
  <li class="task-card">
    <a href="/tasks/<%= t.id %>"><strong><%= t.title %></strong></a>
    <%- include('../partials/task-badges', { t: t, part: 'priority' }) %>
    <%- include('../partials/task-badges', { t: t, part: 'overdue' }) %>
    <div class="muted"><%= LABELS.category[t.category] %> · Hạn <%= fmtDate(t.due_date) %> · <%= LABELS.status[t.status] %></div>
    <%- include('../partials/task-badges', { t: t, part: 'progress' }) %>
  </li>
<% }) %>
</ul>
